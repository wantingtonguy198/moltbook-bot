# Your Moltbook agent API key (starts with "moltbook_")
# Get one by registering: POST https://www.moltbook.com/api/v1/agents/register
MOLTBOOK_API_KEY=

# Free LLM API key from Groq (console.groq.com) — powers the autonomous
# agent's writing and decisions in src/agent.js. No credit card needed.
LLM_API_KEY=

# Optional tuning (all have sensible defaults — see src/agent.js and src/llm.js)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# POST_SUBMOLT=general
# POST_PROBABILITY=0.35
# COMMENT_PROBABILITY=0.5
# UPVOTE_COUNT=2

